{
  "rewrites": [{ "source": "/((?!sw\\.js|manifest\\.webmanifest|parent-manifest\\.webmanifest|teacher-manifest\\.webmanifest|icon-.*\\.png|logo\\.png|assets/).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
